# Server port (default: 3000)
PORT=3000

# REQUIRED in production — secret for signing JWT tokens (min 32 chars)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Optional JWT expiry (default: 7d)
# JWT_EXPIRES_IN=7d

# Default passwords for first-time database seed only
# ADMIN_DEFAULT_PASSWORD=your-secure-admin-password
# WRITER_DEFAULT_PASSWORD=your-secure-writer-password

# Directory containing the SQLite database and uploads (default: project root)
# Dokploy mounts its persistent named volume here.
# DATA_DIR=/app/data
